    {
      "parameters": {
        "jsCode": "// const output = $input.item.json.output;\n\n// // Remove tool debug info\n// let cleanResponse = output;\n// if (output.includes('[Used tools:')) {\n//   const lastBracketIndex = output.lastIndexOf(']');\n//   if (lastBracketIndex !== -1) {\n//     cleanResponse = output.substring(lastBracketIndex + 1).trim();\n//   }\n// }\n\n// // Escape markdown special characters for Telegram Legacy\n// cleanResponse = cleanResponse\n//   .replace(/\\_/g, '\\\\_')   // Escape underscores\n//   .replace(/\\*/g, '\\\\*')   // Escape asterisks\n//   .replace(/\\[/g, '\\\\[')   // Escape brackets\n//   .replace(/\\`/g, '\\\\`');  // Escape backticks\n\n// const chatId = $('Extract User Info').item.json.chat_id;\n\n// return [{\n//   json: {\n//     clean_response: cleanResponse,\n//     chat_id: chatId\n//   }\n// }];\n\n\nconst output = $input.item.json.output;\nconst toolCalls = $input.item.json.toolCalls || [];\nconst chatId = $('Extract User Info').item.json.chat_id;\n\n// Clean debug text\nlet cleanResponse = output;\nif (output.includes('[Used tools:')) {\n  const lastBracketIndex = output.lastIndexOf(']');\n  if (lastBracketIndex !== -1) {\n    cleanResponse = output.substring(lastBracketIndex + 1).trim();\n  }\n}\n\n// Check if search_properties was called and has results\nconst searchCall = toolCalls.find(c => c.name === 'search_properties');\nconst hasProperties = searchCall && searchCall.result && searchCall.result.length > 0;\n\nlet propertyData = null;\n\nif (hasProperties) {\n  // Extract properties with photos\n  const properties = searchCall.result;\n  \n  propertyData = properties.map(property => {\n    const photos = property.fields['Photos'] || [];\n    const firstPhoto = photos.length > 0 ? photos[0].url : null;\n    \n    return {\n      property_id: property.fields['Property ID'],\n      address: property.fields['Address'],\n      city: property.fields['City'],\n      price: property.fields['Price'],\n      bedrooms: property.fields['Bedrooms'],\n      bathrooms: property.fields['Bathrooms'],\n      sqft: property.fields['Square Feet'],\n      description: property.fields['Description'],\n      photo_url: firstPhoto,\n      caption: `🏠 ${property.fields['Address']}\n📍 ${property.fields['City']}\n💰 $${property.fields['Price'].toLocaleString()}\n🛏️ ${property.fields['Bedrooms']} bed | 🛁 ${property.fields['Bathrooms']} bath | 📐 ${property.fields['Square Feet']} sqft\n\n${property.fields['Description']}`\n    };\n  });\n}\n\nreturn [{\n  json: {\n    clean_response: cleanResponse,\n    chat_id: chatId,\n    has_properties: hasProperties,\n    properties: propertyData\n  }\n}];"
      },
