    {
      "parameters": {
        "jsCode": "const labData = $('Route Data Type').first().json.body;\nconst vitals = $('Pull Patient Vitals').first().json;\n\nlet sofa = 0;\nconst flags = [];\n\n// --- Vitals-based scoring ---\nif (vitals.respiratory_rate >= 22) {\n  sofa++;\n  flags.push(`High RR: ${vitals.respiratory_rate} (≥22)`);\n}\nif (vitals.systolic_bp <= 100) {\n  sofa++;\n  flags.push(`Low SBP: ${vitals.systolic_bp} (≤100)`);\n}\nif (vitals.heart_rate >= 100) {\n  sofa++;\n  flags.push(`Tachycardia: HR ${vitals.heart_rate} (≥100)`);\n}\nif (vitals.map < 65) {\n  sofa++;\n  flags.push(`Low MAP: ${vitals.map} (<65)`);\n}\nif (vitals.spo2 < 95) {\n  sofa++;\n  flags.push(`Low SpO2: ${vitals.spo2}% (<95)`);\n}\nif (vitals.temperature_c >= 38.3 || vitals.temperature_c <= 36.0) {\n  sofa++;\n  flags.push(`Abnormal Temp: ${vitals.temperature_c}°C`);\n}\n\n// --- Lab-based scoring ---\nif (labData.labs.wbc > 12 || labData.labs.wbc < 4) {\n  sofa++;\n  flags.push(`Abnormal WBC: ${labData.labs.wbc} (normal 4-12)`);\n}\nif (labData.labs.lactate > 2.0) {\n  sofa += 2;\n  flags.push(`Elevated Lactate: ${labData.labs.lactate} (>2.0)`);\n}\nif (labData.labs.creatinine > 1.2) {\n  sofa++;\n  flags.push(`Elevated Creatinine: ${labData.labs.creatinine} (>1.2)`);\n}\nif (labData.labs.platelets < 150) {\n  sofa++;\n  flags.push(`Low Platelets: ${labData.labs.platelets} (<150)`);\n}\nif (labData.labs.procalcitonin > 0.5) {\n  sofa += 2;\n  flags.push(`Elevated Procalcitonin: ${labData.labs.procalcitonin} (>0.5)`);\n}\nif (labData.labs.bilirubin > 1.2) {\n  sofa++;\n  flags.push(`Elevated Bilirubin: ${labData.labs.bilirubin} (>1.2)`);\n}\nif (labData.labs.band_neutrophils > 10) {\n  sofa++;\n  flags.push(`Elevated Bands: ${labData.labs.band_neutrophils}% (>10%)`);\n}\n\n// --- Risk classification ---\nlet risk_level = \"LOW\";\nif (sofa >= 3) risk_level = \"MODERATE\";\nif (sofa >= 6) risk_level = \"HIGH\";\nif (sofa >= 9) risk_level = \"CRITICAL\";\n\nreturn [{\n  json: {\n    patient_id: labData.patient_id,\n    patient_name: labData.patient_name,\n    age: labData.age,\n    ward: labData.ward,\n    bed: labData.bed,\n    vitals_timestamp: vitals.timestamp,\n    labs_timestamp: labData.timestamp,\n    data_type: \"combined\",\n    vitals: {\n      heart_rate: parseFloat(vitals.heart_rate),\n      systolic_bp: parseFloat(vitals.systolic_bp),\n      diastolic_bp: parseFloat(vitals.diastolic_bp),\n      respiratory_rate: parseFloat(vitals.respiratory_rate),\n      temperature_c: parseFloat(vitals.temperature_c),\n      spo2: parseFloat(vitals.spo2),\n      map: parseFloat(vitals.map)\n    },\n    labs: labData.labs,\n    sofa_score: sofa,\n    risk_level: risk_level,\n    flags: flags\n  }\n}];"
      },
