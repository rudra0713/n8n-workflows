    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\nconst vitals = item.body.vitals;\n\nlet qsofa = 0;\nconst flags = [];\n\n// qSOFA criteria\nif (vitals.respiratory_rate >= 22) {\n  qsofa++;\n  flags.push(`High RR: ${vitals.respiratory_rate} (≥22)`);\n}\n\nif (vitals.systolic_bp <= 100) {\n  qsofa++;\n  flags.push(`Low SBP: ${vitals.systolic_bp} (≤100)`);\n}\n\nif (vitals.heart_rate >= 100) {\n  flags.push(`Tachycardia: HR ${vitals.heart_rate} (≥100)`);\n}\n\nif (vitals.temperature_c >= 38.3 || vitals.temperature_c <= 36.0) {\n  flags.push(`Abnormal Temp: ${vitals.temperature_c}°C`);\n}\n\nif (vitals.spo2 < 95) {\n  flags.push(`Low SpO2: ${vitals.spo2}% (<95)`);\n}\n\nif (vitals.map < 65) {\n  flags.push(`Low MAP: ${vitals.map} (<65)`);\n}\n\nlet risk_level = \"LOW\";\nif (qsofa === 1) risk_level = \"MODERATE\";\nif (qsofa >= 2) risk_level = \"HIGH\";\n\nreturn [{\n  json: {\n    patient_id: item.body.patient_id,\n    patient_name: item.body.patient_name,\n    age: item.body.age,\n    ward: item.body.ward,\n    bed: item.body.bed,\n    timestamp: item.body.timestamp,\n    data_type: item.body.data_type,\n    vitals: vitals,\n    qsofa_score: qsofa,\n    risk_level: risk_level,\n    flags: flags\n  }\n}];"
      },
