    {
      "parameters": {
        "jsCode": "const row = $input.item.json;\n\n// List of required fields (everything except status and chat_id)\nconst requiredFields = [\n  'property_location',\n  'property_type', \n  'budget',\n  'client_name',\n  'client_address',\n  'client_email',\n  'client_phone_number'\n];\n\n// Check which fields are blank/empty\nconst missingFields = requiredFields.filter(field => {\n  const value = row[field];\n  return !value || value === '' || value === null || value === undefined;\n});\n\n// All complete if no missing fields\nconst isComplete = missingFields.length === 0;\n\n// Set message based on completion status\nconst message = isComplete \n  ? \"Thanks for the information. An agent will contact you soon.\"\n  : \"Please provide the remaining information.\";\n\nreturn [{\n  json: {\n    ...row,\n    is_complete: isComplete,\n    message: message\n  }\n}];"
      },
