        "text": "={{ $json.text}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"property_location\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The neighborhood, area, or city where the client wants to find property (e.g., Kitsilano, Downtown Vancouver, Burnaby). Set to null if not mentioned.\"\n    },\n    \"property_type\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The type of property: condo, house, townhouse, apartment, duplex. Set to null if not mentioned.\"\n    },\n    \"budget\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The client's budget as a numeric value or string (e.g., 900000 or 500K). Set to null if not mentioned.\"\n    },\n    \"client_name\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The full name of the client including first and last name. Set to null if not mentioned.\"\n    },\n    \"client_address\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The complete current residential address including street, apartment, city, province, and postal code. Set to null if not mentioned.\"\n    },\n    \"client_email\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The email address in standard format (e.g., name@example.com). Set to null if not mentioned.\"\n    },\n    \"client_phone_number\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The phone number with country code and formatting (e.g., +1 (604) 555-0199). Set to null if not mentioned.\"\n    }\n  },\n  \"required\": [\"property_location\", \"property_type\", \"budget\", \"client_name\", \"client_address\", \"client_email\", \"client_phone_number\"]\n}",
        "options": {}
      },
