    {
      "parameters": {
        "jsCode": "const properties = items.map(item => item.json).filter(p => p && p.id);\n\nif (properties.length === 0) {\n  return [{\n    json: {\n      property_context: \"NO_PROPERTY_FOUND\",\n      properties: []  // ✅ Added\n    }\n  }];\n}\n\n// Build formatted string for found properties\nconst lines = [\"Available properties (match user's address request):\"];\n\nproperties.forEach((prop) => {\n  lines.push(\n    `- ID: ${prop.id}`,\n    `  Address: ${prop.Address || 'Unknown'}`,\n    `  Viewing Restrictions: ${prop[\"Viewing Restrictions\"] || 'None'}`,\n    \"\"\n  );\n});\n\nconst context = lines.join('\\n').trim();\n\nreturn [{\n  json: {\n    property_context: context,\n    properties: properties  // ✅ Added\n  }\n}];"
      },
