    {
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0, 0, 0, 0); // Reset time to midnight for date-only comparison\n\nconst activePatients = [];\n\nfor (const patient of $input.all()) {\n  const startDate = new Date(patient.json['Start Date']);\n  const endDate = new Date(patient.json['End Date']);\n  \n  startDate.setHours(0, 0, 0, 0);\n  endDate.setHours(0, 0, 0, 0);\n  \n  // Check if today is between start and end date and patient is active\n  if (today >= startDate && today <= endDate && patient.json.Status === 'Active') {\n    activePatients.push({\n      json: patient.json\n    });\n  }\n}\n\nreturn activePatients;"
      },
