    },
    {
      "parameters": {
        "text": "=Analyze the following California Court of Appeal opinion and extract key information for attorney research.\n\nCase Name: {{ $('Split Out').item.json.caseName }}\nCourt: {{ $('Split Out').item.json.court }}\nDate Filed: {{ $('Split Out').item.json.dateFiled }}\nDocket Number: {{ $('Split Out').item.json.docketNumber }}\n\nFull Opinion Text:\n{{ $json.plain_text }}\n\nInstructions:\n- Identify the primary practice area (Employment Law, Family Law, Criminal Law, Civil Rights, Contract Law, Tort Law, etc.)\n- Extract the main legal issue and the court's holding\n- Summarize key facts that led to the decision\n- Explain the court's reasoning\n- Include one powerful quote (under 200 chars) that captures the essence of the ruling\n- Note the procedural posture (trial court decision, what happened on appeal)\n- Assess the practical impact for attorneys\n- Identify distinguishing factors that make this case unique\n- Suggest how attorneys could apply this case\n- Rate relevance as High (landmark/significant impact), Medium (important precedent), or Low (narrow application)\n\nFor bullet point fields (key_facts, distinguishing_factors), format as:\n- Point one\n- Point two\n- Point three",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"case_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full case name\"\n    },\n    \"citation\": {\n      \"type\": \"string\",\n      \"description\": \"Case citation if available, or 'Not yet available' if not\"\n    },\n    \"court\": {\n      \"type\": \"string\",\n      \"description\": \"Full court name\"\n    },\n    \"date_filed\": {\n      \"type\": \"string\",\n      \"description\": \"Date the opinion was filed (YYYY-MM-DD format)\"\n    },\n    \"docket_number\": {\n      \"type\": \"string\",\n      \"description\": \"Court docket number\"\n    },\n    \"practice_area\": {\n      \"type\": \"string\",\n      \"description\": \"Primary practice area (e.g., Employment Law, Family Law, Criminal Law, Civil Rights, etc.)\"\n    },\n    \"issue\": {\n      \"type\": \"string\",\n      \"description\": \"The main legal issue addressed by the court in 1-2 sentences\"\n    },\n    \"holding\": {\n      \"type\": \"string\",\n      \"description\": \"The court's holding/decision in 2-3 sentences\"\n    },\n    \"key_facts\": {\n      \"type\": \"string\",\n      \"description\": \"Key facts of the case as 3-5 bullet points in a single string\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"Court's legal reasoning in 3-4 sentences\"\n    },\n    \"relevant_quote\": {\n      \"type\": \"string\",\n      \"description\": \"One key quote from the opinion under 200 characters\"\n    },\n    \"procedural_posture\": {\n      \"type\": \"string\",\n      \"description\": \"Brief procedural history in 1-2 sentences\"\n    },\n    \"impact\": {\n      \"type\": \"string\",\n      \"description\": \"Practical impact and significance in 2-3 sentences\"\n    },\n    \"distinguishing_factors\": {\n      \"type\": \"string\",\n      \"description\": \"Key distinguishing factors as 2-4 bullet points in a single string\"\n    },\n    \"practical_applications\": {\n      \"type\": \"string\",\n      \"description\": \"How attorneys can use this case in 2-3 sentences\"\n    },\n    \"relevance_score\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\"],\n      \"description\": \"Relevance score based on practice area importance and impact\"\n    }\n  },\n  \"required\": [\n    \"case_name\",\n    \"citation\",\n    \"court\",\n    \"date_filed\",\n    \"docket_number\",\n    \"practice_area\",\n    \"issue\",\n    \"holding\",\n    \"key_facts\",\n    \"reasoning\",\n    \"relevant_quote\",\n    \"procedural_posture\",\n    \"impact\",\n    \"distinguishing_factors\",\n    \"practical_applications\",\n    \"relevance_score\"\n  ],\n  \"additionalProperties\": false\n}",
        "options": {}
      },
